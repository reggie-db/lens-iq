{
  "name": "lens-iq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Governed computer-vision operations demo for distributed retail, built with Databricks AppKit",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsdown --out-dir build --entry.index server/server.ts",
    "build:client": "npm run typecheck && vite build --config client/vite.config.ts",
    "deploy": "scripts/deploy.sh",
    "start": "node build/index.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "dependencies": {
    "@databricks/appkit": "^0.43.0",
    "@databricks/appkit-ui": "^0.43.1",
    "@dbx-tools/appkit": "0.6.1",
    "@dbx-tools/appkit-mastra": "0.6.1",
    "@dbx-tools/email": "0.6.1",
    "@dbx-tools/ui-mastra": "0.6.1",
    "@tailwindcss/vite": "^4.1.11",
    "consola": "^3.4.2",
    "express": "^5.0.0",
    "lucide-react": "^0.525.0",
    "marked": "^17.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "3.0.6",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.1.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
