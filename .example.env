# Databricks workspace used by local AppKit development and bundle commands.
DATABRICKS_CONFIG_PROFILE=FEVM-REGGIE-PIERCE-AWS
DATABRICKS_WAREHOUSE_ID=a2171589c3905bc7
BUNDLE_VAR_warehouse_id=a2171589c3905bc7

# Unity Catalog target. Keep BUNDLE_VAR_catalog aligned with
# DATABRICKS_CATALOG so local runtime and bundle resources use the same data.
DATABRICKS_CATALOG=reggie_pierce_aws_catalog
BUNDLE_VAR_catalog=reggie_pierce_aws_catalog
DATABRICKS_SCHEMA=lens_iq

# Genie space backing Ask LensIQ.
DATABRICKS_GENIE_SPACE_ID=01f186bee4ce16f1ac00f8b0df1c88d6

# Databricks Model Serving endpoints.
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-claude-opus-4-7
DATABRICKS_SERVING_ENDPOINT_LLM=databricks-claude-opus-4-7
DATABRICKS_SERVING_ENDPOINT_DETECTOR=lensiq-detector
DATABRICKS_SERVING_ENDPOINT_LICENSE_PLATE=lensiq-license-plate
DATABRICKS_SERVING_ENDPOINT_SLIP_FALL=lensiq-slip-fall
DATABRICKS_SERVING_ENDPOINT_FOG_DETECTOR=lensiq-fog-detector
DATABRICKS_SERVING_ENDPOINT_FACE_RECOGNITION=lensiq-face-recognition

# Unity Catalog volumes used by the AppKit files plugin.
DATABRICKS_VOLUME_FILES=/Volumes/reggie_pierce_aws_catalog/lens_iq/frames
DATABRICKS_VOLUME_FRAMES=/Volumes/reggie_pierce_aws_catalog/lens_iq/frames
DATABRICKS_VOLUME_INBOX=/Volumes/reggie_pierce_aws_catalog/lens_iq/frames_inbox
DATABRICKS_VOLUME_SAMPLE_VIDEOS=/Volumes/reggie_pierce_aws_catalog/lens_iq/sample_videos
DATABRICKS_VOLUME_PRESENTER_CONTENT=/Volumes/reggie_pierce_aws_catalog/lens_iq/presenter_content

# Lakebase Autoscaling. Leave PGHOST and PGDATABASE unset so autopg resolves
# both from this endpoint in the selected workspace.
LAKEBASE_ENDPOINT=projects/lens-iq/branches/production/endpoints/primary
PGPORT=5432
PGSSLMODE=require

# Optional deploy-time key. Used only to download Roboflow Universe model
# assets when building the license-plate and slip/fall serving endpoints.
ROBOFLOW_API_KEY=

# Optional SMTP configuration for the approval-gated send_email agent tool.
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DOMAIN=
EMAIL_FROM=

# Set false to disable the business-hours Model Serving keep-alive worker.
SERVING_ENDPOINT_KEEP_ALIVE=true
